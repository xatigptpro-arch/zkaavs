[Unit]
Description=ZKAAVS API
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/labkar/zkaavs/backend
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=FRONTEND_ORIGINS=https://zkaavs.app,https://www.zkaavs.app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
