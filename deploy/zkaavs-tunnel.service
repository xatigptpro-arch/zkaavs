[Unit]
Description=ZKAAVS Cloudflare Tunnel
After=network.target zkaavs-backend.service
Wants=zkaavs-backend.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config /home/labkar/zkaavs/deploy/cloudflared.yml run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
